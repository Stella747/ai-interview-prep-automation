        {
            "id": 1,
            "module": "gemini-ai:simpleTextPrompt",
            "version": 1,
            "parameters": {},
            "mapper": {
                "model": "gemini-2.5-flash",
                "textPrompt": "You are an experienced technical interviewer and interview coach.\r\n\r\nPrepare interview practice material using the following inputs:\r\n\r\nRole: {{9.role}}\r\nTopic: {{9.topic}}\r\nDifficulty: {{9.difficulty}}\r\n\r\nGenerate 5 interview questions appropriate to the specified role, topic, and difficulty.\r\n\r\nFor each question, include:\r\n1. Interview question\r\n2. Strong sample answer\r\n3. Practical workplace example\r\n4. Likely follow-up question\r\n\r\nUse clear, professional English. Keep answers concise but useful. Do not invent personal work experience for the candidate.\r\n\r\nIf the role is Business Analyst, emphasize requirements, stakeholders, process analysis, SQL, and Agile where relevant.\r\nIf the role is Solution Architect, emphasize solution design, APIs, databases, cloud architecture, integrations, and trade-offs where relevant.\r\n\r\nReturn the result with numbered questions and clear headings."
            },
            "metadata": {
                "designer": {
                    "x": 282,
                    "y": -5
                },
                "setupValidation": {
                    "version": 1,
                    "configuration": "ca7db44722f6a0fd",
                    "result": {
                        "valid": true,
                        "fields": []
                    }
                },
                "restore": {
                    "expect": {
                        "model": {
                            "label": "Gemini 2.5 FlashApplies smart reasoning to fast data tasks while ensuring quick response times"
                        }
                    }
                },
                "expect": [
                    {
                        "name": "model",
                        "type": "select",
                        "label": "Model",
                        "required": true,
                        "validate": {
                            "enum": [
                                "gemini-2.5-flash",
                                "gemini-4-argon",
                                "gemini-3.8-flash",
                                "gemini-3.7-flash",
                                "gemini-3.6-flash",
                                "gemini-3.5-flash",
                                "gemini-3.1-pro-preview",
                                "gemini-3-flash-preview",
                                "gemini-2.5-pro"
                            ]
                        }
                    },
                    {
                        "name": "textPrompt",
                        "type": "text",
                        "label": "Text prompt",
                        "required": true
                    }
                ]
            }
        },
